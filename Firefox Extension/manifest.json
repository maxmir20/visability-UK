{
  "manifest_version": 2,
  "name": "Visability",
  "version": "1.0.0",
  "description": "Checks job posting sites against a list of companies with UK Sponsor Licences",
  "icons": {
    "16": "images/visa_icon16.png",
    "32": "images/visa_icon32.png",
    "48": "images/visa_icon48.png",
    "128": "images/visa_icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "https://www.linkedin.com/*",
    "https://*.charityjob.co.uk/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["utils.js", "jobSiteHandler.js", "content.js"]
    },
    {
      "matches": ["https://*.charityjob.co.uk/*"],
      "js": ["utils.js", "jobSiteHandler.js", "content.js"]
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Visa-bility",
    "default_icon": {
      "16": "images/visa_icon16.png",
      "32": "images/visa_icon32.png",
      "48": "images/visa_icon48.png",
      "128": "images/visa_icon128.png"
    }
  },
  "web_accessible_resources": [
    "companies.txt"
  ]
}
